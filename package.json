{
  "name": "system-design-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run content:index && vite",
    "prebuild": "npm run content:index && npm run content:validate",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "content:migrate": "tsx --tsconfig tsconfig.scripts.json scripts/migrate-ts-to-content.ts",
    "content:index": "tsx --tsconfig tsconfig.scripts.json scripts/build-content-index.ts",
    "content:validate": "tsx --tsconfig tsconfig.scripts.json scripts/content/validate.ts",
    "content:gaps": "tsx --tsconfig tsconfig.scripts.json scripts/content/gaps.ts",
    "content:generate": "tsx --tsconfig tsconfig.scripts.json scripts/content/generate.ts",
    "content:deepen": "tsx --tsconfig tsconfig.scripts.json scripts/content/deepen.ts",
    "content:critique": "tsx --tsconfig tsconfig.scripts.json scripts/content/critique.ts",
    "content:approve": "tsx --tsconfig tsconfig.scripts.json scripts/content/approve.ts",
    "content:refresh": "tsx --tsconfig tsconfig.scripts.json scripts/content/refresh.ts",
    "content:organize": "tsx --tsconfig tsconfig.scripts.json scripts/content/organize.ts",
    "scout:fetch": "tsx --tsconfig tsconfig.scripts.json scripts/scout/fetch.ts",
    "scout:analyze": "tsx --tsconfig tsconfig.scripts.json scripts/scout/analyze.ts",
    "scout:digest": "tsx --tsconfig tsconfig.scripts.json scripts/scout/digest.ts",
    "scout:propose": "tsx --tsconfig tsconfig.scripts.json scripts/scout/propose.ts",
    "scout:run": "tsx --tsconfig tsconfig.scripts.json scripts/scout/run.ts",
    "scout:now": "tsx --tsconfig tsconfig.scripts.json scripts/scout/on-demand.ts --mode full",
    "scout:topic": "tsx --tsconfig tsconfig.scripts.json scripts/scout/on-demand.ts --mode topic",
    "scout:lesson": "tsx --tsconfig tsconfig.scripts.json scripts/scout/on-demand.ts --mode lesson",
    "server": "tsx --tsconfig tsconfig.scripts.json server/index.ts",
    "design:contrast": "tsx --tsconfig tsconfig.scripts.json scripts/design/contrast.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/google": "^4.0.122",
    "@ai-sdk/openai": "^4.0.121",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/overpass": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/space-mono": "^5.3.0",
    "@hono/node-server": "^2.1.9",
    "ai": "^7.0.177",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.19",
    "mermaid": "^12.3.0",
    "minisearch": "^7.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
